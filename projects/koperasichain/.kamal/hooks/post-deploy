# Context7: https://context7.com/basecamp/kamal-site
# Pattern: Verification and notification after deployment
# ═══════════════════════════════════════════════════
# This hook runs AFTER deployment completes successfully
# Useful for: smoke tests, notifications, monitoring
# ═══════════════════════════════════════════════════

set -e

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✅ Post-Deploy: KoperasiChain"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
